FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app

RUN apt-get update && apt-get install -y curl && \
    curl -L https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64 \
    -o /usr/local/bin/cloudflared && \
    chmod +x /usr/local/bin/cloudflared

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY ["TunnelManager.Worker/TunnelManager.Worker.csproj", "TunnelManager.Worker/"]
COPY ["TunnelManager.Shared/TunnelManager.Shared.csproj", "TunnelManager.Shared/"]
RUN dotnet restore "TunnelManager.Worker/TunnelManager.Worker.csproj"
COPY . .
WORKDIR "/src/TunnelManager.Worker"
RUN dotnet publish -c Release -o /app/publish

FROM base AS final
WORKDIR /app
COPY --from=build /app/publish .
COPY --from=build /usr/local/bin/cloudflared /usr/local/bin/cloudflared
ENTRYPOINT ["dotnet", "TunnelManager.Worker.dll"]
