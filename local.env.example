# ─────────────────────────────────────────────────────────────────
# TunnelManager — Required Environment Variables
# Copy this file to local.env and fill in real values.
# NEVER commit real values to version control.
# ─────────────────────────────────────────────────────────────────

# ────────────── TunnelManager.ConfigApi ──────────────────────────

# PostgreSQL connection string (Render managed DB or your own)
DATABASE_URL=Host=your-postgres-host;Port=5432;Database=tunnelmanager;Username=your_user;Password=your_password;SSL Mode=Require;Trust Server Certificate=true

# HashiCorp Vault server address
VAULT_ADDR=http://your-vault-server:8200

# HashiCorp Vault root/service token — keep this highly restricted
VAULT_TOKEN=your-vault-token-here

# Shared secret used by the Worker to authenticate to the Config API
# Generate with: openssl rand -hex 32
INTERNAL_CONFIG_API_KEY=your-strong-random-key-here

# ────────────── TunnelManager.Worker ─────────────────────────────

# URL of the Config API instance (e.g. Render service URL)
CONFIG_API_URL=https://your-config-api.onrender.com

# Same shared secret as above
INTERNAL_CONFIG_API_KEY=your-strong-random-key-here
